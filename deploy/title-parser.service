[Unit]
Description=Title Parser HTTP Service
After=network.target

[Service]
Type=simple
User=title-parser
Group=title-parser
WorkingDirectory=/app/title-parser
Environment=CONFIG_DIR=/app/title-parser/configs
Environment=PORT=8080
Environment=GIN_MODE=release
ExecStart=/app/title-parser/title-parser
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
